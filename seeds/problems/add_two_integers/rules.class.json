{
  "problem": "add_two_integers",
  "time_limit_s": 1,
  "memory_limit_mb": 64,
  "reference_solution": "reference.c",
  "sample_input": "sample.in",
  "input_spec": {
    "generator": "two_ints"
  },
  "feedback": {
    "llm_tutor_note": true
  },
  "metrics": [
    {
      "name": "correctness",
      "analyzer": "io_tests",
      "weight": 0.2,
      "params": {
        "testset_dir": "tests/"
      }
    },
    {
      "name": "syntax",
      "analyzer": "compiler_warnings",
      "weight": 0.1,
      "params": {
        "flags": "-Wall -Wextra -Werror -std=c11"
      }
    },
    {
      "name": "structure",
      "analyzer": "static_analysis",
      "weight": 0.05,
      "params": {
        "max_cyclomatic": 8,
        "max_function_length": 40
      }
    },
    {
      "name": "codacy",
      "analyzer": "codacy_review",
      "weight": 0.05,
      "params": {
        "mode": "local",
        "penalty": {
          "Error": 0.15,
          "Warning": 0.08,
          "Info": 0.03
        },
        "max_penalty": 0.6,
        "fail_if_unavailable": false
      }
    },
    {
      "name": "modularity",
      "analyzer": "function_split",
      "weight": 0.1,
      "params": {
        "expect_helpers": true,
        "min_functions": 2
      }
    },
    {
      "name": "logical",
      "analyzer": "edge_case_runner",
      "weight": 0.1,
      "params": {
        "cases": [
          "negatives",
          "zero",
          "int_overflow"
        ],
        "random_trials": 100,
        "seed": 7
      }
    },
    {
      "name": "complexity",
      "analyzer": "complexity_estimator",
      "weight": 0.1,
      "params": {
        "required": "O(1)",
        "sizes": [
          1,
          10,
          100
        ]
      }
    },
    {
      "name": "memory_safety",
      "analyzer": "sanitizer_run",
      "weight": 0.1,
      "params": {
        "flags": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "readability",
      "analyzer": "llm_review",
      "weight": 0.1,
      "params": {
        "provider": "ollama",
        "model": "qwen2.5-coder:7b",
        "temperature": 0,
        "seed": 42,
        "use_static_findings": true
      }
    },
    {
      "name": "originality",
      "analyzer": "similarity_flag",
      "weight": 0.1,
      "params": {
        "corpus_dir": "submissions/",
        "flag_threshold": 0.85
      }
    },
    {
      "name": "ai_origin",
      "analyzer": "ai_detector",
      "weight": 0,
      "params": {
        "penalize": false
      }
    }
  ],
  "pre_analysis": {
    "llm": true,
    "params": {
      "model": "qwen2.5-coder:7b",
      "temperature": 0,
      "seed": 42
    },
    "use_static_findings": true
  }
}
